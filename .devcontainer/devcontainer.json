{
  "customizations": {
    "vscode": {
      "extensions": [
        "mkhl.direnv",
        "ms-python.python",
        "-ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "detachhead.basedpyright"
      ],
      "settings": {
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "basedpyright.importStrategy": "fromEnvironment",
        "python.defaultInterpreterPath": "${workspaceFolder}/.devenv/state/venv/bin/python",
        "python.languageServer": "None",
        "ruff.importStrategy": "fromEnvironment"
      }
    },
    "zed": {
      "extensions": []
    }
  },
  "image": "ghcr.io/cachix/devenv/devcontainer:latest",
  "overrideCommand": false,
  "updateContentCommand": "devenv shell -- true"
}
